+        int maxFsetSize = 0;
+        int branchingEdges = 0;
+        int totalFsetEdges = 0;
+        for (RootedTreeEdge edge : lambdaEdges) {
+            int fsetSize = edge.getFset() == null ? 0 : edge.getFset().size();
+            maxFsetSize = Math.max(maxFsetSize, fsetSize);
+            if (fsetSize > 1) {
+                branchingEdges++;
